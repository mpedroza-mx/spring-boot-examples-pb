{{ define "email.custom" }}
<html>
<head>
    <style>

        .custom_table table{
            border-collapse: collapse;
            width: 100%;
        }
        .custom_table th,
        .custom_table td{
           border: 1px solid black;
           padding: 8px
        }
    </style>
</head>>

<body style="font-family: Arial, sans-serif;">


{{ if eq .Status "firing" }}
<h2 style="color: #d32f2f;">Alerts Firing</h2>
<table class="custom_table">
    <thead>
    <tr style="background-color: #f5f5f5;">
        <th>Alert</th>
        <th>Instance</th>
        <th>Summary</th>
        <th>Severity</th>
        <th>Status</th>
        <th>Source</th>
    </tr>
    </thead>

    <tbody>
    {{ range .Alerts }}
    <tr>
        <td>
            {{ .Labels.alertname }}
        </td>

        <td>
            {{ .Labels.instance }}
        </td>

        <td>
            {{ .Annotations.summary }}
        </td>

        <td>
            {{ .Labels.severity  }}
        </td>

        <td>
            {{ .Status }}
        </td>
        <td>
            <a href="{{ .GeneratorURL }}">
                View in Prometheus
            </a>
        </td>
    </tr>

    </tbody>
    {{ end }}
</table>


{{ else }}
<h2 style="color: #388e3c;">Alerts Resolved</h2>
<table class="custom_table">
    <thead>
    <tr style="background-color: #f5f5f5;">
        <th>Alert</th>
        <th>Instance</th>
        <th>Severity</th>
        <th>Status</th>
        <th>Source</th>
    </tr>
    </thead>

    <tbody>
    {{ range .Alerts }}
    <tr>
        <td>
            {{ .Labels.alertname }}
        </td>

        <td>
            {{ .Labels.instance }}
        </td>

        <td>
            {{ .Labels.severity }}
        </td>

        <td>
            {{ .Status }}
        </td>
        <td>
            <a href="{{ .GeneratorURL }}">
                View in Prometheus
            </a>
        </td>
    </tr>


    </tbody>
    {{ end }}
</table>

{{ end }}

<div>
    <table width="100%">
        <tr>
            <td><a href='{{ .ExternalURL }}'>View in Alert Manager</a></td>
        </tr>
    </table>
</div>
</body>

</html>
{{ end }}